# Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321
ADMIN_USERNAME=your_telegram_username

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/chirchiq_bot
DB_ECHO=False

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Scraper Settings
SCRAPER_ENABLED=True
SCRAPER_INTERVAL=3600
SCRAPER_TIMEOUT=30

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
PHOTOS_PER_AD=10
MAX_DESCRIPTION_LENGTH=1000

# Webhook (optional)
USE_WEBHOOK=False
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Telegram Mini App (web server runs inside the bot process)
WEBAPP_ENABLED=True
# Public HTTPS URL of the mini app (e.g. cloudflared tunnel). Leave empty to hide the app buttons.
WEBAPP_URL=
