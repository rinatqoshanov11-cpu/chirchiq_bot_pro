# Telegram bot
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=[123456789]
ADMIN_USERNAME=your_telegram_username

# PostgreSQL (any form works: postgres://, postgresql://...?sslmode=require, postgresql+asyncpg://)
DATABASE_URL=postgresql://postgres:password@localhost:5432/chirchiq_bot
DB_ECHO=False

# App
DEBUG=False
LOG_LEVEL=INFO
PHOTOS_PER_AD=10
MIN_PHOTOS_PER_AD=3
MAX_DESCRIPTION_LENGTH=1000

# Telegram Mini App (web server runs inside the bot process)
WEBAPP_ENABLED=True
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Public HTTPS address of the mini app. On Render it is detected automatically.
WEBAPP_URL=
